{
  "name": "ai-for-boss",
  "version": "0.0.0-dev",
  "private": true,
  "description": "AI for Boss desktop product shell, built on OpenClaw.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.2.2"
  },
  "scripts": {
    "contracts:generate": "node scripts/generate-desktop-contract.mjs",
    "build": "node scripts/stage-document-tools.mjs && corepack pnpm run contracts:generate && corepack pnpm --filter @aifb/desktop build",
    "dev": "corepack pnpm run build && corepack pnpm --filter @aifb/desktop start",
    "lint": "eslint .",
    "typecheck": "corepack pnpm --filter @aifb/desktop typecheck",
    "test": "node --test tests/unit/*.test.mjs tests/contract/openclaw-boundary.test.mjs tests/contract/beta-0-runtime-contract.test.mjs",
    "package:desktop": "corepack pnpm run build && node scripts/package-desktop.mjs",
    "qa:prepare": "corepack pnpm run build && node scripts/generate-feature-0.5-qa.mjs",
    "verify": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build",
    "smoke:gateway": "node scripts/gateway-smoke.mjs",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "smoke:packaged": "node scripts/packaged-runtime-smoke.mjs",
    "smoke:app": "node scripts/packaged-app-smoke.mjs",
    "smoke:ui": "node scripts/run-first-session-ui-smoke.mjs",
    "verify:provider": "node scripts/provider-verify.mjs",
    "documents:install": "npm ci --prefix packages/document-tools --ignore-scripts --no-audit --no-fund",
    "documents:stage": "node scripts/stage-document-tools.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.2.1",
    "@electron/asar": "4.2.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
}

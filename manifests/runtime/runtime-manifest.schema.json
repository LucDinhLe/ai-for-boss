{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiforboss.local/schemas/runtime-manifest.schema.json",
  "title": "AI for Boss runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productVersion",
    "releaseTrainId",
    "generatedAt",
    "status",
    "components",
    "platforms",
    "capabilities",
    "knownLimitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "productVersion": {
      "type": "string",
      "minLength": 1
    },
    "releaseTrainId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["candidate", "locked", "released", "blocked"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "role", "status", "source", "integrity"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": ["string", "null"]
        },
        "role": {
          "enum": ["runtime", "desktop-shell", "package-manager", "gateway-client", "gateway-protocol"]
        },
        "status": {
          "enum": ["candidate", "locked", "unavailable-upstream", "not-bundled"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "type": ["string", "null"]
        },
        "license": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "status", "hardRequirements", "artifact"],
      "properties": {
        "os": {
          "enum": ["windows", "macos", "linux"]
        },
        "architecture": {
          "enum": ["x64", "arm64"]
        },
        "status": {
          "enum": ["supported", "verified-limited", "experimental", "unsupported"]
        },
        "hardRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact": {
          "type": ["object", "null"],
          "properties": {
            "url": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "signature": {
              "type": ["string", "null"]
            }
          },
          "required": ["url", "sha256", "signature"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

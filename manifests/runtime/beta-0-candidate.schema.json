{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiforboss.local/schemas/beta-0-candidate.schema.json",
  "title": "AI for Boss beta 0 candidate release train",
  "description": "A candidate train the product runs against for evidence. It is deliberately a separate document from the locked train so nothing can promote it by editing one field.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateTrainId",
    "supersedesLockedTrainId",
    "status",
    "capturedAt",
    "purpose",
    "why",
    "components",
    "integrationSurface",
    "evidence",
    "promotionBlockers",
    "advertisable"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "candidateTrainId": {
      "type": "string",
      "minLength": 1
    },
    "supersedesLockedTrainId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "candidate"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "type": "string",
      "minLength": 80
    },
    "why": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "role",
          "source",
          "integrity",
          "license"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "runtime",
              "gateway-client",
              "gateway-protocol"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
          },
          "buildId": {
            "type": "string",
            "minLength": 7
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integrationSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "transport",
        "clientId",
        "role",
        "scopes",
        "referenceDocuments"
      ],
      "properties": {
        "protocolVersion": {
          "type": "integer"
        },
        "transport": {
          "const": "websocket-text-json"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "operator"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "referenceDocuments": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "source",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "const": "npm-package"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "architecture",
          "level",
          "artifact",
          "linuxSubsystemUsed"
        ],
        "properties": {
          "platform": {
            "enum": [
              "linux",
              "win32",
              "darwin"
            ]
          },
          "architecture": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "spike-tested",
              "documented-primary-source",
              "assumption-pending",
              "blocked-or-not-feasible"
            ]
          },
          "artifact": {
            "type": [
              "string",
              "null"
            ]
          },
          "linuxSubsystemUsed": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "promotionBlockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 40
      }
    },
    "advertisable": {
      "const": false
    },
    "appLaunchEvidence": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiforboss.local/schemas/source-of-truth.schema.json",
  "title": "AI for Boss source-of-truth and data-flow manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseTrainId", "sources", "flows"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "releaseTrainId": { "const": "oc-2026.7.1-2-locked.1" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "flows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/flow" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "role", "authoritativeDomains", "writers", "readers", "rules", "failureBehavior"],
      "properties": {
        "id": { "type": "string", "pattern": "^SOT-[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["openclaw", "ai-for-boss", "operating-system", "user", "release-pipeline", "future-control-plane"] },
        "role": { "enum": ["authoritative", "credential-authority", "immutable-contract", "recovery-artifact", "future-authority"] },
        "authoritativeDomains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "writers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "readers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "failureBehavior": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "data", "trustBoundary", "control"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "data": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "trustBoundary": { "type": ["string", "null"] },
        "control": { "type": "string", "minLength": 1 }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "trigger", "steps", "untrustedInputs", "secrets", "approvals", "failureBehavior", "threatRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^DF-[0-9]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "untrustedInputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "secrets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "approvals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "failureBehavior": { "type": "string", "minLength": 1 },
        "threatRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^T-[0-9]{2}$" } }
      }
    }
  }
}
